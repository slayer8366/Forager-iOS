+            }
+            // read on crafted lines: line ends \n, \r and \r\n, a missing lat, a missing lon, bad numbers, no file.
+            val crafted = listOf(
+                "<trkpt lon=\"1.5\" lat=\"2.25\">\r<trkpt lon=\"-3\" lat=\"4\">\r\n<trkpt lon=\"5\" lat=\"6\">",
